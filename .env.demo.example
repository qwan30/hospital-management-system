# =============================================================================
# DEMO / INTERVIEW ENVIRONMENT — synthetic data only. NEVER use in production.
# =============================================================================
#
# Why this file exists separately from .env.example:
#
#   The release-demo seed deliberately fails closed. Every account password is
#   read from an env var with an EMPTY default (application.yml), and
#   ReleaseDemoSeedProperties.requireComplete() throws IllegalStateException if
#   any is blank. Because the seed runs from a CommandLineRunner, that exception
#   propagates out of SpringApplication.run() and the JVM exits — so a missing
#   password is a hard startup failure, not a silently empty database.
#
#   .env.example stays production-shaped (seed disabled, no credentials). This
#   file is the demo counterpart: copy it when you want the seeded walkthrough.
#
# Usage:
#   cp .env.demo.example .env
#   docker compose -f infra/docker-compose.yml up -d postgres
#   ./backend/run.ps1
#
# The passwords below are the same synthetic values published in the README
# demo-account table. They are gated twice: by HMS_RELEASE_DEMO_SEED_ENABLED
# and by DemoSeedPolicy, which only permits the dev/test/demo/release-demo
# profiles and fails closed on an empty or mixed profile set.
# -----------------------------------------------------------------------------

# --- Core secrets: replace these, they are NOT optional ---------------------
# The app refuses to start without them (no fallbacks, by design).
POSTGRES_PASSWORD=hospital_pass
JWT_SECRET=replace-with-a-random-string-of-at-least-32-characters
PATIENT_IDENTIFIER_SECRET=replace-with-a-random-string-of-at-least-32-chars

# --- Database ----------------------------------------------------------------
POSTGRES_DB=hospital_db
POSTGRES_USER=hospital_user
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# --- Profile -----------------------------------------------------------------
# Must be one of dev | test | demo | release-demo, or DemoSeedPolicy blocks the
# seed. A mixed set such as "dev,observability" also fails closed.
SPRING_PROFILES_ACTIVE=dev

# --- API endpoints -----------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=http://localhost:8081/api/v1
API_BASE_URL_SERVER=http://localhost:8081/api/v1

# --- CORS / cookies ----------------------------------------------------------
HMS_ALLOW_CREDENTIALS=true
HMS_ALLOWED_ORIGIN_PRIMARY=http://localhost:3000
HMS_ALLOWED_ORIGIN_SECONDARY=http://127.0.0.1:3000
HMS_PUBLIC_RATE_LIMIT_PER_MINUTE=30

# false is correct for http://localhost only. Set true on any HTTPS deployment,
# otherwise the httpOnly refresh cookie ships without the Secure flag.
HMS_SECURE_COOKIES=false
HMS_REFRESH_COOKIE_SAME_SITE=Lax

# Swagger UI + /actuator/prometheus without auth. Local demo convenience only.
HMS_EXPOSE_SPEC_ENDPOINTS=true

# --- Release-demo seed -------------------------------------------------------
# Seeds 9 staff accounts, 8 patients, appointments in several clinical states,
# invoices (paid and unpaid), inventory and audit logs.
HMS_RELEASE_DEMO_SEED_ENABLED=true
HMS_RELEASE_DEMO_FUTURE_SLOT_DAYS=14
HMS_RELEASE_DEMO_TARGET_PATIENTS=8
HMS_RELEASE_DEMO_TARGET_APPOINTMENTS=12
HMS_RELEASE_DEMO_TARGET_INVENTORY_ITEMS=8
HMS_RELEASE_DEMO_TARGET_AUDIT_LOGS=16

# All 7 are required when the flag above is true — a blank one aborts startup.
# One password per ROLE, shared by every account holding that role, so both
# doctor1@ and doctor2@ (and doctor3@, doctor4@) use the DOCTOR value.
HMS_RELEASE_DEMO_SEED_PASSWORD_DOCTOR=Doctor@1234
HMS_RELEASE_DEMO_SEED_PASSWORD_NURSE=Nurse@1234
HMS_RELEASE_DEMO_SEED_PASSWORD_RECEPTIONIST=Reception@1234
HMS_RELEASE_DEMO_SEED_PASSWORD_PHARMACIST=Pharma@1234
HMS_RELEASE_DEMO_SEED_PASSWORD_ACCOUNTANT=Acc@1234
HMS_RELEASE_DEMO_SEED_PASSWORD_ADMIN=Admin@1234
HMS_RELEASE_DEMO_SEED_PASSWORD_PATIENT=Patient@1234

# --- Other seeds: leave disabled ---------------------------------------------
# Enabling initial-demo requires all 8 HMS_SEED_PASSWORD_* vars, and it also
# unlocks the non-billing seed below, which needs its own doctor password.
# Both fail closed the same way.
HMS_INITIAL_DEMO_SEED_ENABLED=false
HMS_NON_BILLING_DEMO_SEED_ENABLED=false

# --- Email (optional) --------------------------------------------------------
# Left blank: appointment-reminder email is skipped rather than failing.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
